modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Engagera Web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Engagera Pitch Deck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Engagera Mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mockup Sandbox"

[[workflows.workflow]]
name = "Engagera Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/engagera run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Engagera Pitch Deck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 BASE_PATH=/pitch-deck/ pnpm --filter @workspace/engagera-pitch-deck run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Engagera Mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3002 BASE_PATH=/mobile/ pnpm --filter @workspace/mobile run dev"
waitForPort = 3002

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Mockup Sandbox"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3003 BASE_PATH=/__mockup pnpm --filter @workspace/mockup-sandbox run dev"
waitForPort = 3003

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_TOKEN = "pdsUuloHEYcjb_Xj9d9PbM6GeM1SwMYqhZHRgEwm"
