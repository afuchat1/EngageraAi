# ─────────────────────────────────────────────────────────────────────────────
# Engagera — Required Environment Variables
# Copy this file to .env.local for local development.
# For Vercel deployment: add all of these in the Vercel dashboard under
# Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server-side — kept secret) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase (client-side — safe to expose) ────────────────────────────────────
# These are baked into the frontend bundle at build time by Vite.
# They must be set in Vercel BEFORE the build runs.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── OpenRouter (AI completions via Express API) ────────────────────────────────
# Used by the Express /api/chat route.
# The Supabase Edge Function has its own copy stored in Supabase Secrets.
OPENROUTER_API_KEY=your-openrouter-api-key
