{
  "extends": "../../tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "moduleResolution": "node16",
    "module": "node16",
    "target": "es2022"
  },
  "include": ["src"]
}
