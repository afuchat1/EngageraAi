{
  "name": "@afuchat1/engagera",
  "version": "0.2.0",
  "description": "The official Engagera AI SDK — build AI-powered chat and search engines with AfuBot",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/build-cjs.mjs",
    "dev": "tsc --watch --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "afuchat",
    "afubot",
    "search",
    "crawler",
    "spider",
    "ai",
    "streaming",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://engagera.afuchat.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/afuchat1/EngageraAi"
  }
}
